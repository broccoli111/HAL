{
  "name": "hal-core",
  "version": "0.1.0",
  "description": "HAL v0.1 local-only controlled baseline and M1 skeleton",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage .vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "m1:demo": "npm run build && node ./dist/src/cli/m1DemoCli.js",
    "m2:demo": "npm run build && node ./dist/src/cli/m2DemoCli.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "security:scan": "npm audit --audit-level=high",
    "m0:source-manifest": "node ./scripts/generate-source-manifest.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "hal",
    "controlled-baseline",
    "local-only"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
