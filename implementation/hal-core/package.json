{
  "name": "hal-core",
  "version": "0.1.0",
  "description": "HAL v0.1 local-only implemented M0-M4 slice with M5 assurance controls",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage .vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "m1:demo": "npm run build && node ./dist/src/cli/m1DemoCli.js",
    "m2:demo": "npm run build && node ./dist/src/cli/m2DemoCli.js",
    "m3:demo": "npm run build && node ./dist/src/cli/m3DemoCli.js",
    "m4:demo": "npm run build && node ./dist/src/cli/m4DemoCli.js",
    "m5:backup-restore": "npm run build && node ./dist/src/cli/m5BackupRestoreCli.js",
    "m6:inquire": "npm run build && node ./dist/src/cli/m6InquiryCli.js",
    "m9:packs": "npm run build && node ./dist/src/cli/m9PacksCli.js",
    "m7:session": "npm run build && node ./dist/src/cli/m7SessionCli.js",
    "m8:copy-assets": "node ./scripts/copy-m8-assets.mjs",
    "m8:desktop": "npm run build && npm run m8:copy-assets && electron ./dist/src/cli/m8DesktopCli.js",
    "runtime:ask": "npm run build && node ./scripts/ask-gx10-hermes.mjs",
    "runtime:chat": "npm run build && node ./scripts/chat-gx10-hermes.mjs",
    "runtime:ask:knowledge": "npm run build && node ./scripts/ask-gx10-hermes-with-approved-knowledge.mjs",
    "runtime:ask:status": "npm run build && node ./scripts/ask-gx10-hermes-repository-status.mjs",
    "runtime:ask:history": "npm run build && node ./scripts/ask-gx10-hermes-repository-history.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "security:scan": "npm audit --audit-level=high",
    "m0:source-manifest": "node ./scripts/generate-source-manifest.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "hal",
    "controlled-baseline",
    "local-only"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "electron": "^43.2.0",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
