{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hal:book-ix:ix-c-0116:1.0",
  "title": "IX-C-0116 List Embodiments Envelope",
  "allOf": [
    {
      "$ref": "../hal-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "contract_id": {
          "const": "IX-C-0116"
        },
        "payload": {
          "type": "object",
          "required": [
            "operation",
            "query",
            "projection",
            "consistency"
          ],
          "properties": {
            "operation": {
              "const": "List Embodiments"
            },
            "query": {
              "type": "object"
            },
            "projection": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "consistency": {
              "enum": [
                "AUTHORITATIVE",
                "SNAPSHOT",
                "BOUNDED_STALE"
              ]
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
