{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HAL Book VI Control Record",
  "type": "object",
  "required": [
    "control_id",
    "title",
    "requirement",
    "applicability",
    "responsible_role",
    "enforcement",
    "evidence",
    "severity",
    "exception_authority",
    "protection_objective",
    "book_i",
    "book_ii",
    "book_iii",
    "book_iv",
    "book_x",
    "chapter"
  ],
  "properties": {
    "control_id": {
      "type": "string",
      "pattern": "^VI-[A-Z]+-[0-9]{2}-[0-9]{3}$"
    },
    "protection_objective": {
      "enum": [
        "Protect HAL",
        "Constrain HAL",
        "Both"
      ]
    },
    "severity": {
      "enum": [
        "Critical",
        "High",
        "Moderate",
        "Low"
      ]
    }
  }
}