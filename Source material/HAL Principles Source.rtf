\ls26\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Return the result to the workflow.\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 \strokec2 That creates a security boundary between \'93the model suggested it\'94 and \'93the system actually did it.\'94\
\pard\pardeftab720\sa280\partightenfactor0

