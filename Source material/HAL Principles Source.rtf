\f1\b\fs36 \cf0 HAL Core responsibilities\
\pard\pardeftab720\sa280\partightenfactor0

\fs28 \cf0 1. Request intake and identity\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b0\fs24 \cf0 HAL Core is the only front door into HAL.\
It should:\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls21\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Accept requests from Otacon, phones, watches, dashboards, automations, and future devices.\
\ls21\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Authenticate the user or device.\
\ls21\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Track the active conversation, user, location context, and permissions.\
\ls21\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Prevent clients from contacting reasoning nodes directly.\
\pard\pardeftab720\sa280\partightenfactor0

