\pard\pardeftab720\partightenfactor0
\cf3 \strokec3 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 \strokec2 C. HAL has a Self Model\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 HAL maintains an internal model describing itself.\
Not just hardware.\
Everything.\
\pard\pardeftab720\partightenfactor0
\cf3 \strokec3 \
\pard\pardeftab720\sa298\partightenfactor0

