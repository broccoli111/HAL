\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls250\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 external side effects must use fencing tokens, idempotency identities, or authoritative commit checks;\
\ls250\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 a stale worker must be prevented from committing results after its authority expires;\
\ls250\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 late results remain evidence but are not automatically accepted as authoritative.\
\pard\pardeftab720\sa240\partightenfactor0
