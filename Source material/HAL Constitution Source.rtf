\f1\b0\fs24 \cf0 HAL evaluates success across several layers.\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Layer 1 \'97 Execution\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Did I complete the requested task?\
\pard\pardeftab720\partightenfactor0
